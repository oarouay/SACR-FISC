# Environment configuration
ENVIRONMENT=development
LOG_LEVEL=INFO

# Application server
API_HOST=0.0.0.0
API_PORT=8000

# Database URLs (Async for FastAPI, Sync for Alembic)
# Note: In Docker Compose, the host is 'postgres'
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/dci_db
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/dci_db

# Local development override example:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/dci_db
# SYNC_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/dci_db

# File Storage
EVIDENCE_STORAGE_PATH=./data/evidence
FIXTURES_PATH=./data/fixtures

# Playwright Facebook Session Configuration
FACEBOOK_STORAGE_STATE=./secrets/facebook-storage-state.json
PLAYWRIGHT_HEADLESS=true

# Crawler Defaults & Two-Stage Limits
CRAWL_DEFAULT_PAGE_TIMEOUT=30000
CRAWL_DEFAULT_TIMEOUT=120000
QUICK_POST_LIMIT=10
DEEP_POST_LIMIT=75
QUICK_MAX_SCROLL_CYCLES=4
DEEP_MAX_SCROLL_CYCLES=25
BLOCK_MEDIA_ON_QUICK_CRAWL=true

# Scoring & Promotion Thresholds
DEEP_CRAWL_THRESHOLD=60.0
REVIEW_THRESHOLD=75.0

# Worker Settings
CRAWLER_CONCURRENCY=2
WORKER_POLL_INTERVAL=2.0
WORKER_MAX_RETRY_ATTEMPTS=3
